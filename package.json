{
  "name": "trackinghaus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:vercel": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run lint && npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "test:alpha": "node --test tests/summary.test.mjs tests/privacy-contract.test.mjs tests/api-contract.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vite": "6.4.3"
  }
}
