{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "include": [
    "api/**/*.js",
    "lib/**/*.js",
    "scripts/**/*.mjs",
    "src/**/*.js",
    "src/**/*.jsx",
    "tests/**/*.mjs",
    "vite.config.mjs",
    "worker/**/*.js"
  ],
  "exclude": ["dist", "node_modules", "qa"]
}
